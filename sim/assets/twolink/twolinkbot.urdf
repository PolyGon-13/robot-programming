<?xml version='1.0' encoding='utf-8'?>
<robot name="twolinkbot">
  <link name="world" />
  <joint name="base_joint" type="fixed">
    <parent link="world" />
    <child link="base_link" />
  </joint>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/base.STL" />
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/base.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0455 -0.0455 0.0455" />
      <mass value="0.1" />
      <inertia ixx="0.00013150833333333336" ixy="0.0" ixz="0.0" iyy="0.00013150833333333336" iyz="0.0" izz="0.00012500000000000003" />
    </inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link" />
    <child link="link1" />
    <origin rpy="0 0 0" xyz="0 0 0.128" />
    <axis xyz="0 0 1" />
    <limit lower="-3.0" upper="3.0" effort="10.0" velocity="3.0" />
  </joint>
  <link name="link1">
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/link1.STL" />
      </geometry>
      <material name="grey" />
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/link1.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0715 0 0.03" />
      <mass value="0.5" />
      <inertia ixx="0.00027075" ixy="0.0" ixz="0.0" iyy="0.001802041666666667" iyz="0.0" izz="0.001802041666666667" />
    </inertial>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="link1" />
    <child link="link2" />
    <origin rpy="0 0 0" xyz="0.143 0 0.052" />
    <axis xyz="0 0 1" />
    <limit lower="-3.0" upper="3.0" effort="10.0" velocity="3.0" />
  </joint>
  <link name="link2">
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/link2.STL" />
      </geometry>
      <material name="grey" />
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/link2.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.051 0 0.003" />
      <mass value="0.2" />
      <inertia ixx="3.9e-05" ixy="0.0" ixz="0.0" iyy="0.0003756" iyz="0.0" izz="0.00041339999999999997" />
    </inertial>
  </link>
</robot>