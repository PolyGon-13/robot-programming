<?xml version="1.0"?>
<robot name="twolinkbot" xmlns:xacro="http://ros.org/wiki/xacro">


  <xacro:include filename="macros.xacro"/>
  <link name="world">
  </link>

  <joint name="base_joint" type="fixed">
      <parent link="world"/>
      <child link="base_link"/>
  </joint>
  
  <link name="base_link">
    <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <mesh
          filename="file://$(find twolink_gazebo)/meshes/base.STL" />
        </geometry>
        <material name="grey">
            <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0 0 0"/>
        <geometry>
          <mesh
          filename="file://$(find twolink_gazebo)/meshes/base.STL" />
        </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.1" length="0.091" radius="0.05">
            <origin xyz="-0.0455 -0.0455 0.0455"/>
    </xacro:inertial_cylinder>
  </link>

    <!--START OF YOUR CODE-->
    <joint name="joint1" type="continuous">
      <parent link="base_link"/>
      <child link="link1"/>
      <origin xyz="0 0 0.128" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    <!--END OF YOUR CODE-->
  </joint>

  <link name="link1">
    <visual>
      <!--START OF YOUR CODE-->
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh
        filename="file://$(find twolink_gazebo)/meshes/link1.STL" />
      </geometry>
      <material name="grey"/>
      <!--END OF YOUR CODE-->
    </visual>
    <collision>
      <!--START OF YOUR CODE-->
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh
        filename="file://$(find twolink_gazebo)/meshes/link1.STL" />
      </geometry>
      <!--END OF YOUR CODE-->
    </collision>

    <xacro:inertial_box mass="0.5" x="0.2" y="0.057" z="0.057">
            <origin xyz="-0.0715 0 0.03"/>
    </xacro:inertial_box>link2
  </link>

    <!--START OF YOUR CODE-->
    <joint name="joint2" type="continuous">
      <parent link="link1"/>
      <child link="link2"/>
      <origin xyz="0.143 0 0.052" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <!--END OF YOUR CODE-->

  <link name="link2">
    <visual>
      <!--START OF YOUR CODE-->
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh
        filename="file://$(find twolink_gazebo)/meshes/link2.STL" />
      </geometry>
      <material name="grey"/>
      <!--END OF YOUR CODE-->
    </visual>
    <collision>
      <!--START OF YOUR CODE-->
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh
        filename="file://$(find twolink_gazebo)/meshes/link2.STL" />
      </geometry>
      <!--END OF YOUR CODE-->
    </collision>

    <xacro:inertial_box mass="0.2" x="0.15" y="0.048" z="0.006">
            <origin xyz="-0.051 0 0.003"/>
    </xacro:inertial_box>
  </link>

  <xacro:property name="cam_back_x" value="0.088"/>
  <xacro:property name="cam_center_y" value="0.0"/>
  <xacro:property name="cam_bottom_z" value="0.016"/>
  <xacro:property name="cam_width" value="0.090"/>
  <xacro:property name="cam_height" value="0.025"/>
  <xacro:property name="cam_depth" value="0.02505"/>
  <xacro:property name="cam_origin_behind_front" value="0.0043"/>
  <xacro:property name="cam_origin_from_center_y" value="0.0175"/>

  <joint name="camera_joint" type="fixed">
    <parent link="link2"/>
    <child link="camera_link"/>
    <origin xyz="${cam_back_x + cam_depth - cam_origin_behind_front} ${cam_center_y + cam_origin_from_center_y} ${cam_bottom_z + cam_height / 2}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="${cam_origin_behind_front - cam_depth / 2} ${-cam_origin_from_center_y} 0"/>
      <geometry>
        <box size="${cam_depth} ${cam_width} ${cam_height}"/>
      </geometry>
      <material name="aluminum">
        <color rgba="0.75 0.75 0.78 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="${cam_origin_behind_front + 0.0005} ${-cam_origin_from_center_y} 0"/>
      <geometry>
        <box size="0.001 ${cam_width - 0.006} ${cam_height - 0.006}"/>
      </geometry>
      <material name="glass_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${cam_origin_behind_front - cam_depth / 2} ${-cam_origin_from_center_y} 0"/>
      <geometry>
        <box size="${cam_depth} ${cam_width} ${cam_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.072" x="${cam_depth}" y="${cam_width}" z="${cam_height}">
            <origin xyz="${cam_origin_behind_front - cam_depth / 2} ${-cam_origin_from_center_y} 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="camera_color_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
    <origin xyz="-0.00022 0.01483 0.00014" rpy="0.0084 -0.0010 0.0045"/>
  </joint>

  <link name="camera_color_frame"/>

  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
  </joint>

  <link name="camera_color_optical_frame"/>




  <gazebo reference="link2">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="link1">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="joint1">
        <command_interface name="position">
        </command_interface>
        <state_interface name="position">
            <param name="initial_value">0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
    </joint>

    <joint name="joint2">
        <command_interface name="position">
        </command_interface>
        <state_interface name="position">
            <param name="initial_value">0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
          <parameters>$(find twolink_gazebo)/config/joint_controller.yaml</parameters>
      </plugin>
  </gazebo>


</robot>
